page {
  background: #ffffff;
  min-height: 100%;
}

.page {
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
}

.search-wrap {
  margin-top: 8rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #F3F4F6;
  gap: 12rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #9CA3AF;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -2rpx;
  width: 12rpx;
  height: 4rpx;
  background: #9CA3AF;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  height: 76rpx;
  line-height: 76rpx;
}

.search-placeholder {
  color: #9CA3AF;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #D1D5DB;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #6B7280;
}

.empty-illus {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 32rpx;
  position: relative;
}

.empty-circle {
  position: absolute;
  top: 32rpx;
  left: 36rpx;
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E5E7EB;
  border-radius: 50%;
}

.empty-line {
  position: absolute;
  height: 8rpx;
  background: #E5E7EB;
  border-radius: 8rpx;
}

.empty-line {
  top: 130rpx;
  left: 24rpx;
  width: 150rpx;
}

.empty-line.short {
  top: 158rpx;
  left: 48rpx;
  width: 100rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9CA3AF;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 32rpx;
}

.card {
  width: calc((100% - 24rpx) / 2);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
  border: 2rpx solid #F3F4F6;
}

.card:active {
  background: #FAFAFA;
}

.thumb {
  width: 100%;
  height: 280rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F9FAFB;
  position: relative;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-placeholder {
  width: 100%;
  height: 100%;
  position: relative;
  background: linear-gradient(135deg, #FAFAFA, #F3F4F6);
}

.sketch {
  position: absolute;
  background: #D1D5DB;
  border-radius: 4rpx;
}

.sketch-1 {
  top: 70rpx;
  left: 40rpx;
  width: 160rpx;
  height: 10rpx;
}

.sketch-2 {
  top: 110rpx;
  left: 40rpx;
  width: 120rpx;
  height: 10rpx;
}

.sketch-3 {
  top: 150rpx;
  left: 40rpx;
  width: 180rpx;
  height: 10rpx;
}

.card-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-foot {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.more-btn {
  width: 56rpx;
  height: 40rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #9CA3AF;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
}

.more-btn:active {
  background: #F3F4F6;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 160rpx;
  height: 160rpx;
  padding: 16rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow:
    0 24rpx 48rpx rgba(17, 24, 39, 0.16),
    0 4rpx 12rpx rgba(17, 24, 39, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  z-index: 50;
  box-sizing: border-box;
}

.fab-hover {
  background: #F9FAFB;
  transform: scale(0.96);
  transition: transform 0.12s;
}

.fab-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #111827;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fab-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.fab-icon::before {
  top: 50%;
  left: 0;
  right: 0;
  height: 4rpx;
  transform: translateY(-50%);
}

.fab-icon::after {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4rpx;
  transform: translateX(-50%);
}

.fab-label {
  font-size: 22rpx;
  color: #111827;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  z-index: 1000;
}

.modal {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.modal-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.modal-input {
  margin-top: 24rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  font-size: 28rpx;
  color: #111827;
}

.modal-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.ghost {
  background: #F3F4F6;
  color: #374151;
}

.modal-btn.primary {
  background: #2563EB;
  color: #FFFFFF;
}
