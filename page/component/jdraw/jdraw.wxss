page {
  background: #FFFFFF;
  height: 100%;
}

.jdraw {
  height: 100%;
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  background: #FFFFFF;
}

/* ===== 顶部工具栏 ===== */
.toolbar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 20rpx);
  left: 20rpx;
  right: 20rpx;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 10rpx;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 24rpx;
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.08),
    0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.tool {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 2rpx;
  border-radius: 18rpx;
  color: #1F2937;
}

.tool.active {
  background: rgba(17, 24, 39, 0.08);
  box-shadow:
    inset 0 0 0 1rpx rgba(17, 24, 39, 0.10),
    0 4rpx 10rpx rgba(17, 24, 39, 0.06);
}

.tool.active .tool-label {
  color: #111827;
  font-weight: 600;
}

.help-tool {
  position: relative;
}

.help-tool .tool-label {
  color: #374151;
  font-weight: 500;
}

.help-tool-dot::after {
  content: '';
  position: absolute;
  right: 18rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #EF4444;
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.16);
}

.tool-label {
  font-size: 20rpx;
  color: #4B5563;
  line-height: 1;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 新建: 加号 */
.plus-icon::before,
.plus-icon::after {
  content: '';
  position: absolute;
  background: #1F2937;
  border-radius: 2rpx;
}

.plus-icon::before {
  top: 50%;
  left: 8rpx;
  right: 8rpx;
  height: 4rpx;
  transform: translateY(-50%);
}

.plus-icon::after {
  left: 50%;
  top: 8rpx;
  bottom: 8rpx;
  width: 4rpx;
  transform: translateX(-50%);
}

/* 选择: 手势 */
.select-icon {
  color: #1F2937;
}

.select-icon::before {
  content: '';
  position: absolute;
  inset: 3rpx;
  background: currentColor;
  -webkit-mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 48 48' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20.5 4c-2.2 0-4 1.8-4 4v13.6l-2.7-3.2c-1.4-1.7-4-1.9-5.7-.5-1.6 1.4-1.8 3.8-.6 5.5l9.6 13.2c2.2 3 5.7 4.8 9.4 4.8h4.9c6.3 0 11.4-5.1 11.4-11.4V17.5c0-2.1-1.7-3.8-3.8-3.8-1.1 0-2.1.5-2.8 1.2-.7-1.4-2.1-2.3-3.7-2.3-1.1 0-2.1.4-2.8 1.1-.7-1.3-2.1-2.2-3.7-2.2-.6 0-1.1.1-1.6.3V8c0-2.2-1.8-4-4-4Zm0 3c.6 0 1 .4 1 1v16.8c0 .8.7 1.5 1.5 1.5s1.5-.7 1.5-1.5v-9.1c0-.7.6-1.3 1.3-1.3s1.3.6 1.3 1.3v9.1c0 .8.7 1.5 1.5 1.5s1.5-.7 1.5-1.5v-8.1c0-.7.6-1.3 1.3-1.3s1.3.6 1.3 1.3v8.1c0 .8.7 1.5 1.5 1.5s1.5-.7 1.5-1.5v-6.9c0-.7.6-1.3 1.3-1.3s1.3.6 1.3 1.3V30c0 4.6-3.8 8.4-8.4 8.4h-4.9c-2.8 0-5.4-1.3-7-3.6L10 21.6c-.3-.4-.2-1 .2-1.3.4-.3 1-.2 1.3.1l5.3 6.4c.4.5 1.1.7 1.7.5.6-.2 1-.8 1-1.4V8c0-.6.4-1 1-1Z'/%3E%3C/svg%3E") center / contain no-repeat;
  mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 48 48' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20.5 4c-2.2 0-4 1.8-4 4v13.6l-2.7-3.2c-1.4-1.7-4-1.9-5.7-.5-1.6 1.4-1.8 3.8-.6 5.5l9.6 13.2c2.2 3 5.7 4.8 9.4 4.8h4.9c6.3 0 11.4-5.1 11.4-11.4V17.5c0-2.1-1.7-3.8-3.8-3.8-1.1 0-2.1.5-2.8 1.2-.7-1.4-2.1-2.3-3.7-2.3-1.1 0-2.1.4-2.8 1.1-.7-1.3-2.1-2.2-3.7-2.2-.6 0-1.1.1-1.6.3V8c0-2.2-1.8-4-4-4Zm0 3c.6 0 1 .4 1 1v16.8c0 .8.7 1.5 1.5 1.5s1.5-.7 1.5-1.5v-9.1c0-.7.6-1.3 1.3-1.3s1.3.6 1.3 1.3v9.1c0 .8.7 1.5 1.5 1.5s1.5-.7 1.5-1.5v-8.1c0-.7.6-1.3 1.3-1.3s1.3.6 1.3 1.3v8.1c0 .8.7 1.5 1.5 1.5s1.5-.7 1.5-1.5v-6.9c0-.7.6-1.3 1.3-1.3s1.3.6 1.3 1.3V30c0 4.6-3.8 8.4-8.4 8.4h-4.9c-2.8 0-5.4-1.3-7-3.6L10 21.6c-.3-.4-.2-1 .2-1.3.4-.3 1-.2 1.3.1l5.3 6.4c.4.5 1.1.7 1.7.5.6-.2 1-.8 1-1.4V8c0-.6.4-1 1-1Z'/%3E%3C/svg%3E") center / contain no-repeat;
}

.tool.active .select-icon {
  color: #111827;
}

/* 画笔: 圆圈笔尖 */
.pen-icon {
  width: 44rpx;
  height: 44rpx;
  color: #1F2937;
}

.pen-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.pen-tip {
  position: absolute;
  left: 50%;
  top: 11rpx;
  width: 20rpx;
  height: 24rpx;
  background: currentColor;
  clip-path: polygon(50% 0, 84% 100%, 16% 100%);
  transform: translateX(-50%);
}

.pen-tip::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 10rpx;
  width: 4rpx;
  height: 14rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

.pen-tip::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #FFFFFF;
  transform: translateX(-50%);
}

/* 橡皮: 倾斜的方块 */
.eraser-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 12rpx;
  width: 36rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
  transform: rotate(-30deg);
}

.tool.active .eraser-icon::before {
  border-color: #111827;
}

/* 插图: 图片框 + 小山 */
.image-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 6rpx;
}

.image-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 24rpx;
  height: 12rpx;
  background: #1F2937;
  clip-path: polygon(0 100%, 35% 30%, 60% 70%, 80% 40%, 100% 100%);
}

.tool.active .image-icon::before {
  border-color: #111827;
}

.tool.active .image-icon::after {
  background: #111827;
}

/* 撤销: 弧形箭头 */
.undo-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 30rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
  transform: rotate(45deg);
}

.undo-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 14rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-right: 10rpx solid #1F2937;
}

.tool.active .undo-icon::before {
  border-color: #111827;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.tool.active .undo-icon::after {
  border-right-color: #111827;
}

/* 保存: 软盘 */
.save-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
}

.save-icon::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 20rpx;
  height: 12rpx;
  background: #1F2937;
}

.tool.active .save-icon::before {
  border-color: #111827;
}

.tool.active .save-icon::after {
  background: #111827;
}

/* 导出: 托盘 + 向上箭头 */
.export-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  height: 16rpx;
  border: 4rpx solid #1F2937;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.export-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 4rpx;
  height: 24rpx;
  background: #1F2937;
  border-radius: 2rpx;
  transform: translateX(-50%);
  box-shadow:
    -8rpx 6rpx 0 -2rpx #1F2937,
    8rpx 6rpx 0 -2rpx #1F2937;
}

.tool.active .export-icon::before {
  border-color: #111827;
}

.tool.active .export-icon::after {
  background: #111827;
  box-shadow:
    -8rpx 6rpx 0 -2rpx #111827,
    8rpx 6rpx 0 -2rpx #111827;
}

/* 说明: 问号圆圈 */
.help-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #2563EB;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.08);
}

.help-icon::after {
  content: '?';
  position: absolute;
  left: 0;
  right: 0;
  top: 1rpx;
  text-align: center;
  color: #2563EB;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

/* 双指手势 */
.gesture-icon::before,
.gesture-icon::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 28rpx;
  border: 4rpx solid #1F2937;
  border-radius: 10rpx;
  background: transparent;
}

.gesture-icon::before {
  left: 9rpx;
  top: 8rpx;
  transform: rotate(16deg);
}

.gesture-icon::after {
  right: 9rpx;
  top: 8rpx;
  transform: rotate(-16deg);
}

/* ===== 颜色 + 粗细 悬浮调色板 ===== */
.palette {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.08),
    0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  z-index: 80;
  animation: paletteIn 0.18s ease-out;
}

@keyframes paletteIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.color-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  padding: 0 2rpx;
}

.color-item {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow 0.15s, transform 0.15s;
}

.color-item-active {
  box-shadow:
    0 0 0 3rpx #111827,
    0 0 0 7rpx #FFFFFF;
}

.color-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.rainbow-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  border: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  position: relative;
}

.rainbow-btn::after {
  content: none;
}

.rainbow-inner {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background:
    conic-gradient(
      from 90deg,
      #ef4444, #f97316, #eab308, #22c55e,
      #06b6d4, #3b82f6, #8b5cf6, #ec4899, #ef4444
    );
  box-shadow: 0 4rpx 10rpx rgba(17, 24, 39, 0.25);
  position: relative;
  z-index: 2;
}

.rainbow-active {
  box-shadow:
    0 0 0 3rpx #111827,
    0 0 0 7rpx #FFFFFF;
}

.rainbow-active .rainbow-inner {
  box-shadow:
    0 4rpx 10rpx rgba(17, 24, 39, 0.25);
}

.size-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.size-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #4B5563;
  border-radius: 50%;
  background: #F3F4F6;
  flex-shrink: 0;
}

.size-btn:active {
  background: #E5E7EB;
}

.size-slider {
  flex: 1;
  margin: 0;
}

.size-num {
  min-width: 72rpx;
  text-align: right;
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
  flex-shrink: 0;
}

/* ===== 任意颜色选择弹层 ===== */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.20);
  z-index: 20000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 16rpx 16rpx;
  box-sizing: border-box;
}

.picker-panel {
  width: 100%;
  max-height: 86vh;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 24rpx 72rpx rgba(17, 24, 39, 0.18);
  overflow-y: auto;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx 18rpx;
  position: relative;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.picker-close {
  width: 56rpx;
  height: 56rpx;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  line-height: 52rpx;
  text-align: center;
  font-size: 52rpx;
  color: #111827;
  font-weight: 300;
}

.picker-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 28rpx;
  background: #E5E7EB;
  margin-bottom: 28rpx;
}

.picker-tab {
  flex: 1;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 25rpx;
  color: #111827;
  font-size: 26rpx;
}

.picker-tab-active {
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.08);
  font-weight: 600;
}

.picker-grid-board {
  height: 520rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #F3F4F6;
  display: flex;
  flex-direction: column;
}

.picker-grid-row {
  display: flex;
  flex: 1;
}

.picker-grid-cell {
  flex: 1;
  position: relative;
}

.picker-grid-cell-active::after {
  content: '';
  position: absolute;
  inset: 1rpx;
  border: 5rpx solid #FFFFFF;
  border-radius: 7rpx;
  box-shadow: 0 0 0 2rpx rgba(17, 24, 39, 0.35);
  z-index: 2;
}

.spectrum-shell {
  height: 520rpx;
  box-sizing: border-box;
  overflow: visible;
}

/* 渐变全区域可点（单独 overflow 裁圆角）；手柄百分比相对本层，translate 使圆心落在四边与四角 */
.spectrum-zone {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.spectrum-zone > .picker-thumb-ring {
  z-index: 4;
}

.spectrum-gradient {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  box-sizing: border-box;
  background:
    linear-gradient(to right, #FFFFFF 0%, rgba(255, 255, 255, 0) 56%, #000000 100%),
    linear-gradient(
      to bottom,
      #FF0000 0%,
      #FFFF00 16.7%,
      #00FF00 33.4%,
      #00FFFF 50%,
      #0000FF 66.7%,
      #FF00FF 83.4%,
      #FF0000 100%
    );
}

/**
 * 光谱 / RGB / 不透明度：白环用「白底 + padding」而非 border，避免边线与内圆之间露缝；
 * overflow:hidden + 内层铺满，四角贴边时也不会出现「缺一块」。
 */
.picker-thumb-ring {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background-color: #ffffff;
  padding: 6rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(17, 24, 39, 0.28);
  position: absolute;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.picker-thumb-fill {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-sizing: border-box;
}

.picker-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.rgb-panel {
  height: 520rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.rgb-row {
  display: grid;
  grid-template-columns: 1fr 128rpx;
  grid-template-areas:
    "label label"
    "slider input";
  align-items: center;
  gap: 16rpx;
  row-gap: 8rpx;
}

.rgb-row .picker-label {
  grid-area: label;
  margin-bottom: 0;
}

.rgb-slider-wrap {
  grid-area: slider;
}

.rgb-slider-wrap,
.alpha-slider-wrap {
  height: 64rpx;
  border-radius: 32rpx;
  overflow: visible;
  position: relative;
  display: flex;
  align-items: center;
}

.slider-strip {
  flex: 1;
  margin: 0 24rpx;
  height: 40rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: visible;
}

/* 圆角条两端半圆圆心连线；thumb 的 0%/100% 落在左右圆帽中心（与条形 height / 2 一致） */
.slider-thumb-lane {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.red-strip::before,
.green-strip::before,
.blue-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.35);
}

.red-strip::before {
  background: linear-gradient(to right, #000000, #FF0000);
}

.green-strip::before {
  background: linear-gradient(to right, #000000, #00FF2A);
}

.blue-strip::before {
  background: linear-gradient(to right, #000000, #001CFF);
}

.alpha-strip {
  background:
    linear-gradient(45deg, #D1D5DB 25%, transparent 25%),
    linear-gradient(-45deg, #D1D5DB 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #D1D5DB 75%),
    linear-gradient(-45deg, transparent 75%, #D1D5DB 75%);
  background-color: #F3F4F6;
  background-size: 24rpx 24rpx;
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0;
}

.alpha-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(to right, rgba(0, 0, 0, 0), #000000);
  pointer-events: none;
  z-index: 0;
}

.slider-thumb-rect {
  position: absolute;
  top: 50%;
  z-index: 2;
}

.rgb-input,
.hex-input,
.alpha-value {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  text-align: center;
  font-size: 30rpx;
  color: #111827;
  box-shadow: 0 1rpx 4rpx rgba(17, 24, 39, 0.06);
}

.rgb-input {
  grid-area: input;
  width: 128rpx;
  flex-shrink: 0;
}

.hex-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.hex-label {
  color: #22C7D6;
  font-size: 26rpx;
}

.hex-input {
  width: 160rpx;
  font-weight: 600;
}

.alpha-wrap {
  margin-top: 28rpx;
}

.alpha-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.alpha-slider-wrap {
  flex: 1;
}

.alpha-value {
  width: 128rpx;
  background: #FFFFFF;
  font-weight: 600;
}

.picker-bottom {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-preview-dot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.10);
  flex-shrink: 0;
}

/* ===== 画布 ===== */
.canvas-wrap {
  position: absolute;
  inset: 0;
  padding: 0;
  background: #FFFFFF;
  box-sizing: border-box;
  overflow: hidden;
}

.canvas-stage {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
}

.canvas-grid {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
}

/* ===== 缩放提示 ===== */
.zoom-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  background: rgba(17, 24, 39, 0.85);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.zoom-text {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ===== 教程弹窗 ===== */
.tutorial-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: rgba(17, 24, 39, 0.55);
  box-sizing: border-box;
}

.tutorial-modal {
  width: 100%;
  max-height: 80vh;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.tutorial-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.tutorial-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.tutorial-content {
  margin-top: 24rpx;
}

.tutorial-item {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.tutorial-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.06);
}

.tutorial-icon .tool-icon {
  transform: scale(0.78);
}

.tutorial-text {
  flex: 1;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.5;
}

.tutorial-footer {
  margin-top: 24rpx;
}

.tutorial-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
