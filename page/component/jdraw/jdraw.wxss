@import "../../../styles/drawing-icons.wxss";

page {
  background: #FFFFFF;
  height: 100%;
}

.jdraw {
  height: 100%;
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  background: #FFFFFF;
}

/* ===== 顶部工具栏 ===== */
.toolbar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 20rpx);
  left: 20rpx;
  right: 20rpx;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 10rpx;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 24rpx;
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.08),
    0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.tool {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 2rpx;
  border-radius: 18rpx;
  color: #1F2937;
}

.tool.active {
  background: rgba(17, 24, 39, 0.08);
  box-shadow:
    inset 0 0 0 1rpx rgba(17, 24, 39, 0.10),
    0 4rpx 10rpx rgba(17, 24, 39, 0.06);
}

.tool.active .tool-label {
  color: #111827;
  font-weight: 600;
}

.help-tool {
  position: relative;
}

.help-tool .tool-label {
  color: #374151;
  font-weight: 500;
}

.help-tool-dot::after {
  content: '';
  position: absolute;
  right: 18rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #EF4444;
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.16);
}

.tool-label {
  font-size: 20rpx;
  color: #4B5563;
  line-height: 1;
}

.editing-bar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 152rpx);
  left: 24rpx;
  right: 24rpx;
  z-index: 85;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  pointer-events: none;
}

.history-tools {
  display: flex;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.05);
  pointer-events: auto;
}

.edit-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 88rpx;
  min-width: 100rpx;
  padding: 0 14rpx;
  margin: 0;
  background: transparent;
  font-size: 22rpx;
  line-height: 1.2;
  color: #374151;
  border-radius: 20rpx;
}

.edit-action::after { border: 0; }
.edit-action[disabled] { opacity: 0.3; background: transparent; }
.edit-action .tool-icon { transform: scale(0.7); }
.edit-action .redo-icon { transform: scale(-0.7, 0.7); }
.delete-action { color: #DC2626; }
.draft-status {
  font-size: 20rpx;
  color: #64748B;
  padding: 10rpx 14rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
  line-height: 1.5;
}
.draft-error { color: #B45309; }
.eraser-heading { display: flex; justify-content: space-between; font-size: 24rpx; color: #374151; }
.eraser-hint { color: #64748B; font-size: 22rpx; }
.eraser-size-dot { width: 24rpx; height: 24rpx; border: 3rpx solid #64748B; border-radius: 50%; }

/* ===== 颜色 + 粗细 悬浮调色板 ===== */
.palette {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.08),
    0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  z-index: 80;
  animation: paletteIn 0.18s ease-out;
}

@keyframes paletteIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.color-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  padding: 0 2rpx;
}

.color-item {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow 0.15s, transform 0.15s;
}

.color-item-active {
  box-shadow:
    0 0 0 3rpx #111827,
    0 0 0 7rpx #FFFFFF;
}

.color-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.rainbow-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  border: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  position: relative;
}

.rainbow-btn::after {
  content: none;
}

.rainbow-inner {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background:
    conic-gradient(
      from 90deg,
      #ef4444, #f97316, #eab308, #22c55e,
      #06b6d4, #3b82f6, #8b5cf6, #ec4899, #ef4444
    );
  box-shadow: 0 4rpx 10rpx rgba(17, 24, 39, 0.25);
  position: relative;
  z-index: 2;
}

.rainbow-active {
  box-shadow:
    0 0 0 3rpx #111827,
    0 0 0 7rpx #FFFFFF;
}

.rainbow-active .rainbow-inner {
  box-shadow:
    0 4rpx 10rpx rgba(17, 24, 39, 0.25);
}

.size-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.size-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #4B5563;
  border-radius: 50%;
  background: #F3F4F6;
  flex-shrink: 0;
}

.size-btn:active {
  background: #E5E7EB;
}

.size-slider {
  flex: 1;
  margin: 0;
}

.size-num {
  min-width: 72rpx;
  text-align: right;
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
  flex-shrink: 0;
}

/* ===== 任意颜色选择弹层 ===== */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.20);
  z-index: 20000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 16rpx 16rpx;
  box-sizing: border-box;
}

.picker-panel {
  width: 100%;
  max-height: 86vh;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 24rpx 72rpx rgba(17, 24, 39, 0.18);
  overflow-y: auto;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx 18rpx;
  position: relative;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.picker-close {
  width: 56rpx;
  height: 56rpx;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  line-height: 52rpx;
  text-align: center;
  font-size: 52rpx;
  color: #111827;
  font-weight: 300;
}

.picker-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 28rpx;
  background: #E5E7EB;
  margin-bottom: 28rpx;
}

.picker-tab {
  flex: 1;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 25rpx;
  color: #111827;
  font-size: 26rpx;
}

.picker-tab-active {
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.08);
  font-weight: 600;
}

.picker-grid-board {
  height: 520rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #F3F4F6;
  display: flex;
  flex-direction: column;
}

.picker-grid-row {
  display: flex;
  flex: 1;
}

.picker-grid-cell {
  flex: 1;
  position: relative;
}

.picker-grid-cell-active::after {
  content: '';
  position: absolute;
  inset: 1rpx;
  border: 5rpx solid #FFFFFF;
  border-radius: 7rpx;
  box-shadow: 0 0 0 2rpx rgba(17, 24, 39, 0.35);
  z-index: 2;
}

.spectrum-shell {
  height: 520rpx;
  box-sizing: border-box;
  overflow: visible;
}

/* 渐变全区域可点（单独 overflow 裁圆角）；手柄百分比相对本层，translate 使圆心落在四边与四角 */
.spectrum-zone {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.spectrum-zone > .picker-thumb-ring {
  z-index: 4;
}

.spectrum-gradient {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  box-sizing: border-box;
  background:
    linear-gradient(to right, #FFFFFF 0%, rgba(255, 255, 255, 0) 56%, #000000 100%),
    linear-gradient(
      to bottom,
      #FF0000 0%,
      #FFFF00 16.7%,
      #00FF00 33.4%,
      #00FFFF 50%,
      #0000FF 66.7%,
      #FF00FF 83.4%,
      #FF0000 100%
    );
}

/**
 * 光谱 / RGB / 不透明度：白环用「白底 + padding」而非 border，避免边线与内圆之间露缝；
 * overflow:hidden + 内层铺满，四角贴边时也不会出现「缺一块」。
 */
.picker-thumb-ring {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background-color: #ffffff;
  padding: 6rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(17, 24, 39, 0.28);
  position: absolute;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.picker-thumb-fill {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-sizing: border-box;
}

.picker-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.rgb-panel {
  height: 520rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.rgb-row {
  display: grid;
  grid-template-columns: 1fr 128rpx;
  grid-template-areas:
    "label label"
    "slider input";
  align-items: center;
  gap: 16rpx;
  row-gap: 8rpx;
}

.rgb-row .picker-label {
  grid-area: label;
  margin-bottom: 0;
}

.rgb-slider-wrap {
  grid-area: slider;
}

.rgb-slider-wrap,
.alpha-slider-wrap {
  height: 64rpx;
  border-radius: 32rpx;
  overflow: visible;
  position: relative;
  display: flex;
  align-items: center;
}

.slider-strip {
  flex: 1;
  margin: 0 24rpx;
  height: 40rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: visible;
}

/* 圆角条两端半圆圆心连线；thumb 的 0%/100% 落在左右圆帽中心（与条形 height / 2 一致） */
.slider-thumb-lane {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.red-strip::before,
.green-strip::before,
.blue-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.35);
}

.red-strip::before {
  background: linear-gradient(to right, #000000, #FF0000);
}

.green-strip::before {
  background: linear-gradient(to right, #000000, #00FF2A);
}

.blue-strip::before {
  background: linear-gradient(to right, #000000, #001CFF);
}

.alpha-strip {
  background:
    linear-gradient(45deg, #D1D5DB 25%, transparent 25%),
    linear-gradient(-45deg, #D1D5DB 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #D1D5DB 75%),
    linear-gradient(-45deg, transparent 75%, #D1D5DB 75%);
  background-color: #F3F4F6;
  background-size: 24rpx 24rpx;
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0;
}

.alpha-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(to right, rgba(0, 0, 0, 0), #000000);
  pointer-events: none;
  z-index: 0;
}

.slider-thumb-rect {
  position: absolute;
  top: 50%;
  z-index: 2;
}

.rgb-input,
.hex-input,
.alpha-value {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  text-align: center;
  font-size: 30rpx;
  color: #111827;
  box-shadow: 0 1rpx 4rpx rgba(17, 24, 39, 0.06);
}

.rgb-input {
  grid-area: input;
  width: 128rpx;
  flex-shrink: 0;
}

.hex-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.hex-label {
  color: #22C7D6;
  font-size: 26rpx;
}

.hex-input {
  width: 160rpx;
  font-weight: 600;
}

.alpha-wrap {
  margin-top: 28rpx;
}

.alpha-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.alpha-slider-wrap {
  flex: 1;
}

.alpha-value {
  width: 128rpx;
  background: #FFFFFF;
  font-weight: 600;
}

.picker-bottom {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-preview-dot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.10);
  flex-shrink: 0;
}

/* ===== 画布 ===== */
.canvas-wrap {
  position: absolute;
  inset: 0;
  padding: 0;
  background: #FFFFFF;
  box-sizing: border-box;
  overflow: hidden;
}

.canvas-stage {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
}

.canvas-grid {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
}

/* ===== 缩放提示 ===== */
.zoom-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  background: rgba(17, 24, 39, 0.85);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease;
}

.zoom-toast-visible {
  opacity: 1;
}

.zoom-text {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ===== 教程弹窗 ===== */
.tutorial-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 40rpx;
  background: rgba(17, 24, 39, 0.55);
  box-sizing: border-box;
}

.tutorial-modal {
  width: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.tutorial-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.tutorial-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.tutorial-content {
  margin-top: 24rpx;
  height: 48vh;
  min-height: 0;
  flex-shrink: 1;
}

.tutorial-header,
.tutorial-footer {
  flex-shrink: 0;
}

.tutorial-footer {
  margin-top: 24rpx;
}

.tutorial-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
