page {
  background: #F3F4F6;
  height: 100%;
}

.jdraw {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  background: #F3F4F6;
}

/* ===== 顶部工具栏 ===== */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.tool {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 4rpx;
  border-radius: 16rpx;
  color: #1F2937;
}

.tool.active {
  background: #F3F4F6;
}

.tool.active .tool-label {
  color: #111827;
  font-weight: 600;
}

.tool-label {
  font-size: 22rpx;
  color: #4B5563;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 新建: 加号 */
.plus-icon::before,
.plus-icon::after {
  content: '';
  position: absolute;
  background: #1F2937;
  border-radius: 2rpx;
}

.plus-icon::before {
  top: 50%;
  left: 8rpx;
  right: 8rpx;
  height: 4rpx;
  transform: translateY(-50%);
}

.plus-icon::after {
  left: 50%;
  top: 8rpx;
  bottom: 8rpx;
  width: 4rpx;
  transform: translateX(-50%);
}

/* 选择: 虚线方框 */
.select-icon {
  border: 4rpx dashed #1F2937;
  border-radius: 6rpx;
}

.tool.active .select-icon {
  border-color: #111827;
}

/* 画笔: 倾斜的笔形 */
.pen-icon {
  width: 44rpx;
  height: 44rpx;
}

.pen-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  bottom: 4rpx;
  width: 36rpx;
  height: 8rpx;
  background: #1F2937;
  border-radius: 4rpx;
  transform: rotate(-45deg);
  transform-origin: left bottom;
}

.pen-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  bottom: 4rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 12rpx solid #1F2937;
  transform: rotate(-45deg);
  transform-origin: left bottom;
}

.tool.active .pen-icon::before,
.tool.active .pen-icon::after {
  background: #111827;
}

.tool.active .pen-icon::after {
  border-top-color: #111827;
  background: transparent;
}

/* 橡皮: 倾斜的方块 */
.eraser-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 12rpx;
  width: 36rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
  transform: rotate(-30deg);
}

.tool.active .eraser-icon::before {
  border-color: #111827;
}

/* 插图: 图片框 + 小山 */
.image-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 6rpx;
}

.image-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 24rpx;
  height: 12rpx;
  background: #1F2937;
  clip-path: polygon(0 100%, 35% 30%, 60% 70%, 80% 40%, 100% 100%);
}

.tool.active .image-icon::before {
  border-color: #111827;
}

.tool.active .image-icon::after {
  background: #111827;
}

/* 撤销: 弧形箭头 */
.undo-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 30rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
  transform: rotate(45deg);
}

.undo-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 14rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-right: 10rpx solid #1F2937;
}

.tool.active .undo-icon::before {
  border-color: #111827;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.tool.active .undo-icon::after {
  border-right-color: #111827;
}

/* 保存: 软盘 */
.save-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
}

.save-icon::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 20rpx;
  height: 12rpx;
  background: #1F2937;
}

.tool.active .save-icon::before {
  border-color: #111827;
}

.tool.active .save-icon::after {
  background: #111827;
}

/* 导出: 托盘 + 向上箭头 */
.export-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  height: 16rpx;
  border: 4rpx solid #1F2937;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.export-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 4rpx;
  height: 24rpx;
  background: #1F2937;
  border-radius: 2rpx;
  transform: translateX(-50%);
  box-shadow:
    -8rpx 6rpx 0 -2rpx #1F2937,
    8rpx 6rpx 0 -2rpx #1F2937;
}

.tool.active .export-icon::before {
  border-color: #111827;
}

.tool.active .export-icon::after {
  background: #111827;
  box-shadow:
    -8rpx 6rpx 0 -2rpx #111827,
    8rpx 6rpx 0 -2rpx #111827;
}

/* 说明: 问号圆圈 */
.help-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 50%;
}

.help-icon::after {
  content: '?';
  position: absolute;
  left: 0;
  right: 0;
  top: 1rpx;
  text-align: center;
  color: #1F2937;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

/* ===== 颜色 + 粗细 悬浮调色板 ===== */
.palette {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow:
    0 24rpx 48rpx rgba(17, 24, 39, 0.10),
    0 4rpx 12rpx rgba(17, 24, 39, 0.04);
  z-index: 80;
  animation: paletteIn 0.18s ease-out;
}

@keyframes paletteIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.color-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  padding: 0 2rpx;
}

.color-item {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s, transform 0.15s;
}

.color-item-active {
  border-color: #111827;
}

.color-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.rainbow-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    conic-gradient(
      from 90deg,
      #ef4444, #f97316, #eab308, #22c55e,
      #06b6d4, #3b82f6, #8b5cf6, #ec4899, #ef4444
    );
  position: relative;
}

.rainbow-btn::after {
  content: '';
  position: absolute;
  inset: 4rpx;
  border-radius: 50%;
  background: #FFFFFF;
  z-index: 1;
}

.rainbow-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background:
    conic-gradient(
      from 90deg,
      #ef4444, #f97316, #eab308, #22c55e,
      #06b6d4, #3b82f6, #8b5cf6, #ec4899, #ef4444
    );
  position: relative;
  z-index: 2;
}

.rainbow-active {
  border-color: #111827;
}

.size-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.size-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #4B5563;
  border-radius: 50%;
  background: #F3F4F6;
  flex-shrink: 0;
}

.size-btn:active {
  background: #E5E7EB;
}

.size-slider {
  flex: 1;
  margin: 0;
}

.size-num {
  min-width: 72rpx;
  text-align: right;
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
  flex-shrink: 0;
}

/* ===== 任意颜色选择弹层 ===== */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  z-index: 1100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.picker-cancel {
  font-size: 28rpx;
  color: #6B7280;
  padding: 8rpx 0;
}

.picker-done {
  font-size: 28rpx;
  color: #2563EB;
  font-weight: 600;
  padding: 8rpx 0;
}

.picker-preview-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 8rpx;
}

.picker-preview-dot {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.08);
}

.picker-hex {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  letter-spacing: 2rpx;
  font-family: 'Courier New', monospace;
}

.picker-bar-wrap {
  padding: 8rpx 0 16rpx;
}

.picker-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 6rpx;
}

.hue-track {
  position: relative;
  height: 56rpx;
  display: flex;
  align-items: center;
}

.hue-strip {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  height: 14rpx;
  margin-top: -7rpx;
  border-radius: 7rpx;
  background: linear-gradient(
    to right,
    #ef4444 0%, #f97316 14%, #eab308 28%, #22c55e 42%,
    #06b6d4 56%, #3b82f6 70%, #8b5cf6 84%, #ec4899 100%
  );
  pointer-events: none;
  z-index: 1;
}

.hue-slider {
  width: 100%;
  margin: 0;
  position: relative;
  z-index: 2;
}

.picker-slider {
  margin: 0;
}

.picker-presets-title {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.picker-presets {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* ===== 画布 ===== */
.canvas-wrap {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
  padding: 8rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
  overflow: hidden;
}

.canvas-stage {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: #FFFFFF;
}

.canvas-grid {
  display: block;
}

/* ===== 缩放提示 ===== */
.zoom-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  background: rgba(17, 24, 39, 0.85);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.zoom-text {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ===== 教程弹窗 ===== */
.tutorial-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx calc(120rpx + env(safe-area-inset-bottom));
  background: rgba(17, 24, 39, 0.55);
  box-sizing: border-box;
}

.tutorial-modal {
  width: 100%;
  max-height: 80vh;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.tutorial-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.tutorial-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.tutorial-content {
  margin-top: 24rpx;
}

.tutorial-item {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.tutorial-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.06);
}

.tutorial-icon .tool-icon {
  transform: scale(0.78);
}

.tutorial-text {
  flex: 1;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.5;
}

.tutorial-footer {
  margin-top: 24rpx;
}

.tutorial-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
