page {
  background: #F3F4F6;
  height: 100%;
}

.jdraw {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
  background: #F3F4F6;
}

/* ===== 顶部工具栏 ===== */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.tool {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 0;
  border-radius: 14rpx;
  color: #1F2937;
}

.tool.active {
  background: #EFF6FF;
}

.tool.active .tool-label {
  color: #2563EB;
}

.tool-label {
  font-size: 22rpx;
  color: #4B5563;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 选择: 虚线方框 */
.select-icon {
  border: 4rpx dashed #1F2937;
  border-radius: 6rpx;
}

.tool.active .select-icon {
  border-color: #2563EB;
}

/* 画笔: 倾斜的笔形 */
.pen-icon {
  width: 44rpx;
  height: 44rpx;
}

.pen-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  bottom: 4rpx;
  width: 36rpx;
  height: 8rpx;
  background: #1F2937;
  border-radius: 4rpx;
  transform: rotate(-45deg);
  transform-origin: left bottom;
}

.pen-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  bottom: 4rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 12rpx solid #1F2937;
  transform: rotate(-45deg);
  transform-origin: left bottom;
}

.tool.active .pen-icon::before,
.tool.active .pen-icon::after {
  background: #2563EB;
}

.tool.active .pen-icon::after {
  border-top-color: #2563EB;
  background: transparent;
}

/* 橡皮: 倾斜的方块 */
.eraser-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 12rpx;
  width: 36rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
  transform: rotate(-30deg);
}

.tool.active .eraser-icon::before {
  border-color: #2563EB;
}

/* 插图: 图片框 + 小山 */
.image-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 6rpx;
}

.image-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 24rpx;
  height: 12rpx;
  background: #1F2937;
  clip-path: polygon(0 100%, 35% 30%, 60% 70%, 80% 40%, 100% 100%);
}

.tool.active .image-icon::before {
  border-color: #2563EB;
}

.tool.active .image-icon::after {
  background: #2563EB;
}

/* 清空: 垃圾桶 */
.trash-icon::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #1F2937;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.trash-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 6rpx;
  width: 36rpx;
  height: 6rpx;
  background: #1F2937;
  border-radius: 3rpx;
}

.tool.active .trash-icon::before {
  border-color: #2563EB;
}

.tool.active .trash-icon::after {
  background: #2563EB;
}

/* 撤销: 弧形箭头 */
.undo-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 30rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
  transform: rotate(45deg);
}

.undo-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 14rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-right: 10rpx solid #1F2937;
}

.tool.active .undo-icon::before {
  border-color: #2563EB;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.tool.active .undo-icon::after {
  border-right-color: #2563EB;
}

/* 保存: 软盘 */
.save-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
}

.save-icon::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 20rpx;
  height: 12rpx;
  background: #1F2937;
}

.tool.active .save-icon::before {
  border-color: #2563EB;
}

.tool.active .save-icon::after {
  background: #2563EB;
}

/* ===== 颜色 + 粗细控制栏 ===== */
.control-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.color-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.color-list {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.color-item {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s;
}

.color-item-active {
  border-color: #2563EB;
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #E5E7EB;
  box-sizing: border-box;
}

.size-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 240rpx;
  flex-shrink: 0;
}

.size-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #4B5563;
  border-radius: 50%;
}

.size-btn:active {
  background: #F3F4F6;
}

.size-slider {
  flex: 1;
  margin: 0;
}

/* ===== 画布 ===== */
.canvas-wrap {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
  padding: 8rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
  overflow: hidden;
}

.canvas-stage {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: #FFFFFF;
  background-image:
    linear-gradient(to right, rgba(209, 213, 219, 0.4) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(209, 213, 219, 0.4) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
}

.canvas-grid {
  display: block;
}

/* ===== 缩放提示 ===== */
.zoom-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  background: rgba(17, 24, 39, 0.85);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.zoom-text {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ===== 教程弹窗 ===== */
.tutorial-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: rgba(17, 24, 39, 0.55);
}

.tutorial-modal {
  width: 100%;
  max-height: 80vh;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.tutorial-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.tutorial-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.tutorial-content {
  margin-top: 24rpx;
}

.tutorial-item {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.5;
}

.tutorial-footer {
  margin-top: 24rpx;
}

.tutorial-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
