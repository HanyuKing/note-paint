<view class="jdraw">
  <view class="toolbar">
    <view
      class="tool {{currentMode=='select' ? 'active' : ''}}"
      data-mode="select"
      bindtap="switchMode"
    >
      <view class="tool-icon select-icon"></view>
      <view class="tool-label">选择</view>
    </view>
    <view
      class="tool {{currentMode=='draw' && brushState=='p' ? 'active' : ''}}"
      data-state="p"
      bindtap="switchBrush"
    >
      <view class="tool-icon pen-icon"></view>
      <view class="tool-label">画笔</view>
    </view>
    <view
      class="tool {{currentMode=='draw' && brushState=='c' ? 'active' : ''}}"
      data-state="c"
      bindtap="switchBrush"
    >
      <view class="tool-icon eraser-icon"></view>
      <view class="tool-label">橡皮</view>
    </view>
    <view class="tool" bindtap="chooseImage">
      <view class="tool-icon image-icon"></view>
      <view class="tool-label">插图</view>
    </view>
    <view class="tool" bindtap="drawClear">
      <view class="tool-icon trash-icon"></view>
      <view class="tool-label">清空</view>
    </view>
    <view class="tool" bindtap="drawBack">
      <view class="tool-icon undo-icon"></view>
      <view class="tool-label">撤销</view>
    </view>
    <view class="tool" bindtap="saveBoard">
      <view class="tool-icon save-icon"></view>
      <view class="tool-label">保存</view>
    </view>
  </view>

  <view class="control-bar">
    <scroll-view scroll-x="true" class="color-scroll" enhanced show-scrollbar="{{false}}">
      <view class="color-list">
        <view
          wx:for="{{tinctList}}"
          wx:key="*this"
          class="color-item {{tinctCurr===index ? 'color-item-active' : ''}}"
          data-index="{{index}}"
          bindtap="tinColorChange"
        >
          <view
            class="color-dot"
            style="background-color:{{item}}"
          ></view>
        </view>
      </view>
    </scroll-view>
    <view class="size-controls">
      <view class="size-btn" data-delta="-1" bindtap="adjustSize">−</view>
      <slider
        class="size-slider"
        value="{{tinctSize}}"
        min="1"
        max="10"
        bindchange="tinSizechange"
        activeColor="#2563EB"
        block-color="#2563EB"
        block-size="20"
        backgroundColor="#E5E7EB"
      />
      <view class="size-btn" data-delta="1" bindtap="adjustSize">+</view>
    </view>
  </view>

  <view class="canvas-wrap">
    <view class="canvas-stage">
      <canvas
        class="canvas-grid"
        style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
        canvas-id="palette"
        bindtouchstart="touchstart"
        bindtouchmove="touchMove"
        bindtouchend="touchEnd"
        disable-scroll="true"
        hidden="{{showTutorial}}"
      ></canvas>
      <canvas
        style="width: {{exportWidth}}px; height: {{exportHeight}}px; position: fixed; left: 10000px; top: 0;"
        canvas-id="exportCanvas"
      ></canvas>

      <cover-view class="zoom-toast" wx:if="{{showScaleToast}}">
        <cover-view class="zoom-text">{{scalePercent}}%</cover-view>
      </cover-view>
    </view>
  </view>

  <view class="tutorial-overlay" wx:if="{{showTutorial}}" bindtap="closeTutorial">
    <view class="tutorial-modal" catchtap="stopPropagation">
      <view class="tutorial-header">
        <view class="tutorial-title">使用说明</view>
        <view class="tutorial-subtitle">快速了解画板的基本操作</view>
      </view>
      <view class="tutorial-content">
        <view class="tutorial-item">画笔：选择颜色和粗细后，在画板上自由绘制。</view>
        <view class="tutorial-item">橡皮：使用白色笔迹覆盖已有内容。</view>
        <view class="tutorial-item">选择：点选对象后可拖动位置；空白处单指拖动可平移视图。</view>
        <view class="tutorial-item">插图：从相册或相机插入图片，可继续在上面批注。</view>
        <view class="tutorial-item">保存：保存为可继续编辑的本地文件，可在“文件”tab 查看。</view>
      </view>
      <view class="tutorial-footer">
        <view class="tutorial-btn" bindtap="closeTutorial">知道了</view>
      </view>
    </view>
  </view>
</view>
