<view class="jdraw">
  <view class="toolbar">
    <view
      class="tool {{currentMode=='select' ? 'active' : ''}}"
      data-mode="select"
      bindtap="switchMode"
    >
      <view class="tool-icon select-icon"></view>
      <view class="tool-label">选择</view>
    </view>
    <view
      class="tool {{currentMode=='draw' && brushState=='p' ? 'active' : ''}}"
      data-state="p"
      bindtap="switchBrush"
    >
      <view class="tool-icon pen-icon"></view>
      <view class="tool-label">画笔</view>
    </view>
    <view
      class="tool {{currentMode=='draw' && brushState=='c' ? 'active' : ''}}"
      data-state="c"
      bindtap="switchBrush"
    >
      <view class="tool-icon eraser-icon"></view>
      <view class="tool-label">橡皮</view>
    </view>
    <view class="tool" bindtap="chooseImage">
      <view class="tool-icon image-icon"></view>
      <view class="tool-label">插图</view>
    </view>
    <view class="tool" bindtap="drawBack">
      <view class="tool-icon undo-icon"></view>
      <view class="tool-label">撤销</view>
    </view>
    <view class="tool" bindtap="saveBoard">
      <view class="tool-icon save-icon"></view>
      <view class="tool-label">保存</view>
    </view>
    <view class="tool" bindtap="exportImage">
      <view class="tool-icon export-icon"></view>
      <view class="tool-label">导出</view>
    </view>
    <view class="tool" bindtap="openTutorial">
      <view class="tool-icon help-icon"></view>
      <view class="tool-label">说明</view>
    </view>
  </view>

  <view wx:if="{{currentMode==='draw' && brushState==='p'}}" class="palette">
    <view class="color-row">
      <view
        class="rainbow-btn {{tinctCurr===-1 ? 'rainbow-active' : ''}}"
        catchtap="openColorPicker"
      >
        <view class="rainbow-inner"></view>
      </view>
      <view
        wx:for="{{primaryColors}}"
        wx:key="index"
        class="color-item {{tinctCurr===item.index ? 'color-item-active' : ''}}"
        data-index="{{item.index}}"
        catchtap="tinColorChange"
      >
        <view class="color-dot" style="background-color:{{item.value}}"></view>
      </view>
    </view>

    <view class="size-row">
      <view class="size-btn" data-delta="-1" catchtap="adjustSize">−</view>
      <slider
        class="size-slider"
        value="{{tinctSize}}"
        min="1"
        max="10"
        bindchange="tinSizechange"
        activeColor="#111827"
        block-color="#FFFFFF"
        block-size="24"
        backgroundColor="#E5E7EB"
      />
      <view class="size-btn" data-delta="1" catchtap="adjustSize">+</view>
      <view class="size-num">{{tinctSize}}px</view>
    </view>
  </view>

  <view
    wx:if="{{showColorPicker}}"
    class="picker-mask"
    bindtap="closeColorPicker"
    catchtouchmove="stopPropagation"
  >
    <view
      class="picker-panel"
      catchtap="stopPropagation"
      catchtouchmove="stopPropagation"
    >
      <view class="picker-head">
        <view class="picker-title">选择颜色</view>
        <view class="picker-close" bindtap="closeColorPicker">×</view>
      </view>

      <view class="picker-tabs">
        <view class="picker-tab {{pickerTab==='grid' ? 'picker-tab-active' : ''}}" data-tab="grid" bindtap="switchPickerTab">网格</view>
        <view class="picker-tab {{pickerTab==='spectrum' ? 'picker-tab-active' : ''}}" data-tab="spectrum" bindtap="switchPickerTab">光谱</view>
        <view class="picker-tab {{pickerTab==='slider' ? 'picker-tab-active' : ''}}" data-tab="slider" bindtap="switchPickerTab">滑块</view>
      </view>

      <view wx:if="{{pickerTab==='grid'}}" class="picker-grid-board">
        <view wx:for="{{pickerGrid}}" wx:for-item="row" wx:key="id" class="picker-grid-row">
          <view
            wx:for="{{row.cells}}"
            wx:for-item="cell"
            wx:key="color"
            class="picker-grid-cell {{pickerHex === cell.hex ? 'picker-grid-cell-active' : ''}}"
            style="background-color: {{cell.color}};"
            data-color="{{cell.color}}"
            data-spectrum-x="{{cell.spectrumX}}"
            data-spectrum-y="{{cell.spectrumY}}"
            bindtap="onGridColorPick"
          ></view>
        </view>
      </view>

      <view wx:elif="{{pickerTab==='spectrum'}}" class="spectrum-shell">
        <view class="spectrum-zone">
          <view
            class="spectrum-gradient spectrum-touch-target"
            bindtouchstart="onSpectrumPick"
            bindtouchmove="onSpectrumPick"
            bindtouchend="onSpectrumCommit"
          ></view>
          <view class="picker-thumb-ring" style="left: {{pickerSpectrumX}}%; top: {{pickerSpectrumY}}%;">
            <view class="picker-thumb-fill" style="background-color: {{pickerColor}};"></view>
          </view>
        </view>
      </view>

      <view wx:else class="rgb-panel">
        <view class="rgb-row">
          <view class="picker-label">红色</view>
          <view
            class="rgb-slider-wrap picker-slider-hit"
            data-track-id="pickerTrackR"
            data-channel="r"
            data-max="255"
            bindtouchstart="onPickerSliderTouch"
            bindtouchmove="onPickerSliderTouch"
            bindtouchend="onPickerSliderTouch"
          >
            <view id="pickerTrackR" class="slider-strip red-strip">
              <view class="slider-thumb-lane">
                <view class="slider-thumb-rect picker-thumb-ring" style="left: {{pickerRedThumbPct}}%;">
                  <view class="picker-thumb-fill" style="background-color: {{pickerColor}};"></view>
                </view>
              </view>
            </view>
          </view>
          <input class="rgb-input" value="{{pickerRed}}" disabled />
        </view>
        <view class="rgb-row">
          <view class="picker-label">绿色</view>
          <view
            class="rgb-slider-wrap picker-slider-hit"
            data-track-id="pickerTrackG"
            data-channel="g"
            data-max="255"
            bindtouchstart="onPickerSliderTouch"
            bindtouchmove="onPickerSliderTouch"
            bindtouchend="onPickerSliderTouch"
          >
            <view id="pickerTrackG" class="slider-strip green-strip">
              <view class="slider-thumb-lane">
                <view class="slider-thumb-rect picker-thumb-ring" style="left: {{pickerGreenThumbPct}}%;">
                  <view class="picker-thumb-fill" style="background-color: {{pickerColor}};"></view>
                </view>
              </view>
            </view>
          </view>
          <input class="rgb-input" value="{{pickerGreen}}" disabled />
        </view>
        <view class="rgb-row">
          <view class="picker-label">蓝色</view>
          <view
            class="rgb-slider-wrap picker-slider-hit"
            data-track-id="pickerTrackB"
            data-channel="b"
            data-max="255"
            bindtouchstart="onPickerSliderTouch"
            bindtouchmove="onPickerSliderTouch"
            bindtouchend="onPickerSliderTouch"
          >
            <view id="pickerTrackB" class="slider-strip blue-strip">
              <view class="slider-thumb-lane">
                <view class="slider-thumb-rect picker-thumb-ring" style="left: {{pickerBlueThumbPct}}%;">
                  <view class="picker-thumb-fill" style="background-color: {{pickerColor}};"></view>
                </view>
              </view>
            </view>
          </view>
          <input class="rgb-input" value="{{pickerBlue}}" disabled />
        </view>
        <view class="hex-row">
          <view class="hex-label">sRGB Hex 颜色#</view>
          <input class="hex-input" value="{{pickerHex}}" maxlength="6" bindinput="onHexInput" />
        </view>
      </view>

      <view class="alpha-wrap">
        <view class="picker-label">不透明度</view>
        <view class="alpha-row">
          <view
            class="alpha-slider-wrap picker-slider-hit"
            data-track-id="pickerTrackAlpha"
            data-channel="a"
            data-max="100"
            bindtouchstart="onPickerSliderTouch"
            bindtouchmove="onPickerSliderTouch"
            bindtouchend="onPickerSliderTouch"
          >
            <view id="pickerTrackAlpha" class="slider-strip alpha-strip">
              <view class="slider-thumb-lane">
                <view class="slider-thumb-rect picker-thumb-ring" style="left: {{pickerAlphaThumbPct}}%;">
                  <view class="picker-thumb-fill" style="background-color: {{pickerColor}};"></view>
                </view>
              </view>
            </view>
          </view>
          <view class="alpha-value">{{pickerAlpha}}%</view>
        </view>
      </view>
      <view class="picker-bottom">
        <view class="picker-preview-dot" style="background-color: {{pickerColor}};"></view>
      </view>
    </view>
  </view>

  <view class="canvas-wrap">
    <view class="canvas-stage">
      <canvas
        id="palette"
        class="canvas-grid"
        style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
        canvas-id="palette"
        type="2d"
        bindtouchstart="touchstart"
        bindtouchmove="touchMove"
        bindtouchend="touchEnd"
        disable-scroll="true"
        hidden="{{showTutorial}}"
      ></canvas>
      <canvas
        style="width: {{exportWidth}}px; height: {{exportHeight}}px; position: fixed; left: 10000px; top: 0;"
        canvas-id="exportCanvas"
      ></canvas>

      <cover-view class="zoom-toast" wx:if="{{showScaleToast}}">
        <cover-view class="zoom-text">{{scalePercent}}%</cover-view>
      </cover-view>
    </view>
  </view>

  <view class="tutorial-overlay" wx:if="{{showTutorial}}" bindtap="closeTutorial">
    <view class="tutorial-modal" catchtap="stopPropagation">
      <view class="tutorial-header">
        <view class="tutorial-title">使用说明</view>
        <view class="tutorial-subtitle">快速了解画板的基本操作</view>
      </view>
      <view class="tutorial-content">
        <view class="tutorial-item">
          <view class="tutorial-icon"><view class="tool-icon select-icon"></view></view>
          <view class="tutorial-text">选择：点选对象后可拖动位置；空白处单指拖动可平移视图。</view>
        </view>
        <view class="tutorial-item">
          <view class="tutorial-icon"><view class="tool-icon pen-icon"></view></view>
          <view class="tutorial-text">画笔：选择颜色和粗细后，在画板上自由绘制。</view>
        </view>
        <view class="tutorial-item">
          <view class="tutorial-icon"><view class="tool-icon eraser-icon"></view></view>
          <view class="tutorial-text">橡皮：使用白色笔迹覆盖已有内容。</view>
        </view>
        <view class="tutorial-item">
          <view class="tutorial-icon"><view class="tool-icon image-icon"></view></view>
          <view class="tutorial-text">插图：从相册或相机插入图片，可继续在上面批注。</view>
        </view>
        <view class="tutorial-item">
          <view class="tutorial-icon"><view class="tool-icon save-icon"></view></view>
          <view class="tutorial-text">保存：保存为可继续编辑的本地文件，可在“文件”tab 查看。</view>
        </view>
        <view class="tutorial-item">
          <view class="tutorial-icon"><view class="tool-icon export-icon"></view></view>
          <view class="tutorial-text">导出：将当前画板内容保存为图片到系统相册。</view>
        </view>
      </view>
      <view class="tutorial-footer">
        <view class="tutorial-btn" bindtap="closeTutorial">知道了</view>
      </view>
    </view>
  </view>
</view>
