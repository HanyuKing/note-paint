.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  min-height: 56px;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  box-sizing: border-box;
  /* 保留乳白底色，不支持背景模糊时也能看清导航。 */
  background: rgba(248, 250, 255, 0.86);
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(239, 246, 255, 0.12));
  -webkit-backdrop-filter: blur(24px) saturate(150%);
  backdrop-filter: blur(24px) saturate(150%);
  box-shadow:
    0 12rpx 36rpx rgba(31, 41, 55, 0.10),
    0 2rpx 8rpx rgba(31, 41, 55, 0.04),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(148, 163, 184, 0.12);
  z-index: 100;
}

.tabbar-hidden {
  display: none !important;
}

.tabbar-content {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
}

.glass-selection {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.90);
  border-radius: 999rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, rgba(239, 246, 255, 0.96), rgba(211, 229, 255, 0.78));
  box-shadow:
    0 2rpx 8rpx rgba(37, 99, 235, 0.07),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.90),
    inset 0 -1rpx 0 rgba(147, 197, 253, 0.25);
  pointer-events: none;
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tab {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 999rpx;
  color: #6B7280;
  transition: color 180ms ease, opacity 180ms ease, transform 180ms ease;
}

.tab-on {
  color: #2563EB;
}

.tab-pressed {
  opacity: 0.72;
  transform: scale(0.96);
}

.icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.label {
  font-size: 22rpx;
  line-height: 1.2;
}

.tab-on .label {
  font-weight: 600;
}
