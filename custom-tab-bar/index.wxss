.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  min-height: 56px;
  padding: 8rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.92);
  border-radius: 999rpx;
  box-sizing: border-box;
  /* 保留乳白底色，不支持背景模糊时也能看清导航。 */
  background: rgba(255, 255, 255, 0.92);
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(239, 246, 255, 0.18));
  -webkit-backdrop-filter: blur(24px) saturate(140%);
  backdrop-filter: blur(24px) saturate(140%);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.10);
  z-index: 100;
}

.tabbar-hidden {
  display: none !important;
}

.tabbar-content {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
}

.glass-selection {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border: 1rpx solid rgba(191, 219, 254, 0.92);
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #EFF6FF;
  box-shadow: 0 3rpx 10rpx rgba(37, 99, 235, 0.10);
  pointer-events: none;
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tab {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-radius: 999rpx;
  color: #64748B;
  transition: color 180ms ease, opacity 180ms ease, transform 180ms ease;
}

.tab-on {
  color: #2563EB;
}

.tab-pressed {
  opacity: 0.72;
  transform: scale(0.96);
}

.icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.label {
  font-size: 21rpx;
  line-height: 1.2;
}

.tab-on .label {
  font-weight: 600;
}
