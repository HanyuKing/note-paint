.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #F3F4F6;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.tabbar-hidden {
  display: none !important;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 22rpx;
  gap: 4rpx;
  padding: 12rpx 0 8rpx;
  position: relative;
}

.tab-on {
  color: #2563EB;
}

.icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-icon-img {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.label {
  font-size: 22rpx;
  line-height: 1;
}

.indicator {
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
  margin-top: 2rpx;
}

.indicator-on {
  background: #2563EB;
}
