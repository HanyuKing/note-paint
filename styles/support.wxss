page {
  min-height: 100%;
  background: #FFFFFF;
  color: #111827;
}

.support-page {
  padding: 40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 48rpx;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: #EFF6FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-image {
  width: 72rpx;
  height: 72rpx;
}

.brand-copy {
  min-width: 0;
  margin-left: 24rpx;
}

.brand-title {
  font-size: 40rpx;
  line-height: 1.4;
  font-weight: 700;
}

.brand-description {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #6B7280;
}

.section-title {
  margin: 0 0 20rpx;
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 600;
}

.section-card {
  margin-bottom: 32rpx;
  padding: 28rpx;
  border: 2rpx solid #F3F4F6;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.body-text {
  font-size: 27rpx;
  line-height: 1.8;
  color: #4B5563;
}

.body-text + .body-text {
  margin-top: 16rpx;
}

.page-note {
  margin-top: 36rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #9CA3AF;
  text-align: center;
}
