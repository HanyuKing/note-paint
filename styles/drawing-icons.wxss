.tool-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.delete-icon::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 13rpx;
  width: 22rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-radius: 0 0 5rpx 5rpx;
}

.delete-icon::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 33rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
  box-shadow: 0 -5rpx 0 -1rpx currentColor;
}

/* 新建: 加号 */
.plus-icon::before,
.plus-icon::after {
  content: '';
  position: absolute;
  background: #1F2937;
  border-radius: 2rpx;
}

.plus-icon::before {
  top: 50%;
  left: 8rpx;
  right: 8rpx;
  height: 4rpx;
  transform: translateY(-50%);
}

.plus-icon::after {
  left: 50%;
  top: 8rpx;
  bottom: 8rpx;
  width: 4rpx;
  transform: translateX(-50%);
}

/* 选择: 手势 */
.select-icon {
  color: #1F2937;
}

