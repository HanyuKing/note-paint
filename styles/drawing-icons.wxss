.pen-icon {
  color: #6B7280;
}

.pen-icon::before {
  content: '';
  position: absolute;
  inset: 5rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.pen-tip {
  position: absolute;
  left: 50%;
  top: 11rpx;
  width: 19rpx;
  height: 23rpx;
  background: currentColor;
  clip-path: polygon(50% 0, 84% 100%, 16% 100%);
  transform: translateX(-50%);
}

.pen-tip::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 10rpx;
  width: 3rpx;
  height: 12rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

.pen-tip::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #FFFFFF;
  transform: translateX(-50%);
}

.eraser-icon::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 12rpx;
  width: 34rpx;
  height: 21rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  transform: rotate(-30deg);
}

.image-icon::before {
  content: '';
  position: absolute;
  inset: 5rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}

.image-icon::after {
  content: '';
  position: absolute;
  left: 11rpx;
  bottom: 10rpx;
  width: 22rpx;
  height: 11rpx;
  background: currentColor;
  clip-path: polygon(0 100%, 35% 30%, 60% 70%, 80% 40%, 100% 100%);
}

.undo-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
  transform: rotate(45deg);
}

.undo-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 14rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-right: 9rpx solid currentColor;
}

.save-icon::before {
  content: '';
  position: absolute;
  inset: 5rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}

.save-icon::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 19rpx;
  height: 11rpx;
  background: currentColor;
  border-radius: 1rpx;
}

.export-icon::before {
  content: '';
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  bottom: 5rpx;
  height: 15rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.export-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 5rpx;
  width: 3rpx;
  height: 23rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: translateX(-50%);
  box-shadow: -7rpx 6rpx 0 -1rpx currentColor, 7rpx 6rpx 0 -1rpx currentColor;
}

.help-icon::before {
  content: '';
  position: absolute;
  inset: 5rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.help-icon::after {
  content: '?';
  position: absolute;
  left: 0;
  right: 0;
  top: 1rpx;
  text-align: center;
  color: currentColor;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.gesture-icon::before,
.gesture-icon::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 10rpx;
  background: transparent;
}

.gesture-icon::before {
  left: 9rpx;
  top: 8rpx;
  transform: rotate(16deg);
}

.gesture-icon::after {
  right: 9rpx;
  top: 8rpx;
  transform: rotate(-16deg);
}
