/* 统一线性图标：44rpx 触摸容器，图形保持中性灰或继承当前状态色。 */
.tool-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  color: #6B7280;
}

.tool.active .tool-icon {
  color: #2563EB;
}

.delete-icon::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 13rpx;
  width: 22rpx;
  height: 25rpx;
  border: 3rpx solid currentColor;
  border-radius: 0 0 5rpx 5rpx;
  box-sizing: border-box;
}

.delete-icon::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 8rpx;
  width: 30rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
  box-shadow: 0 -5rpx 0 -1rpx currentColor;
}

.plus-icon::before,
.plus-icon::after {
  content: '';
  position: absolute;
  background: currentColor;
  border-radius: 2rpx;
}

.plus-icon::before {
  top: 50%;
  left: 8rpx;
  right: 8rpx;
  height: 3rpx;
  transform: translateY(-50%);
}

.plus-icon::after {
  left: 50%;
  top: 8rpx;
  bottom: 8rpx;
  width: 3rpx;
  transform: translateX(-50%);
}

