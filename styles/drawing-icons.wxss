.tool.active .select-icon {
  color: #111827;
}

/* 画笔: 圆圈笔尖 */
.pen-icon {
  width: 44rpx;
  height: 44rpx;
  color: #1F2937;
}

.pen-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.pen-tip {
  position: absolute;
  left: 50%;
  top: 11rpx;
  width: 20rpx;
  height: 24rpx;
  background: currentColor;
  clip-path: polygon(50% 0, 84% 100%, 16% 100%);
  transform: translateX(-50%);
}

.pen-tip::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 10rpx;
  width: 4rpx;
  height: 14rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

.pen-tip::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #FFFFFF;
  transform: translateX(-50%);
}

/* 橡皮: 倾斜的方块 */
.eraser-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 12rpx;
  width: 36rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
  transform: rotate(-30deg);
}

.tool.active .eraser-icon::before {
  border-color: #111827;
}

/* 插图: 图片框 + 小山 */
.image-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 6rpx;
}

.image-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 24rpx;
  height: 12rpx;
  background: #1F2937;
  clip-path: polygon(0 100%, 35% 30%, 60% 70%, 80% 40%, 100% 100%);
}

.tool.active .image-icon::before {
  border-color: #111827;
}

.tool.active .image-icon::after {
  background: #111827;
}

/* 撤销: 弧形箭头 */
.undo-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 30rpx;
  height: 22rpx;
  border: 4rpx solid #1F2937;
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
  transform: rotate(45deg);
}

.undo-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 14rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-right: 10rpx solid #1F2937;
}

.tool.active .undo-icon::before {
  border-color: #111827;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.tool.active .undo-icon::after {
  border-right-color: #111827;
}

/* 保存: 软盘 */
.save-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #1F2937;
  border-radius: 4rpx;
}

.save-icon::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 20rpx;
  height: 12rpx;
  background: #1F2937;
}

.tool.active .save-icon::before {
  border-color: #111827;
}

.tool.active .save-icon::after {
  background: #111827;
}

/* 导出: 托盘 + 向上箭头 */
.export-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  height: 16rpx;
  border: 4rpx solid #1F2937;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.export-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 4rpx;
  height: 24rpx;
  background: #1F2937;
  border-radius: 2rpx;
  transform: translateX(-50%);
  box-shadow:
    -8rpx 6rpx 0 -2rpx #1F2937,
    8rpx 6rpx 0 -2rpx #1F2937;
}

.tool.active .export-icon::before {
  border-color: #111827;
}

.tool.active .export-icon::after {
  background: #111827;
  box-shadow:
    -8rpx 6rpx 0 -2rpx #111827,
    8rpx 6rpx 0 -2rpx #111827;
}

/* 说明: 问号圆圈 */
.help-icon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #2563EB;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.08);
}

.help-icon::after {
  content: '?';
  position: absolute;
  left: 0;
  right: 0;
  top: 1rpx;
  text-align: center;
  color: #2563EB;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

/* 双指手势 */
.gesture-icon::before,
.gesture-icon::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 28rpx;
  border: 4rpx solid #1F2937;
  border-radius: 10rpx;
  background: transparent;
}

.gesture-icon::before {
  left: 9rpx;
  top: 8rpx;
  transform: rotate(16deg);
}

.gesture-icon::after {
  right: 9rpx;
  top: 8rpx;
  transform: rotate(-16deg);
}
