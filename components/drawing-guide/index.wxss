@import "../../styles/drawing-icons.wxss";

.tutorial-item {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.tutorial-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.06);
}

.tutorial-icon .tool-icon {
  transform: scale(0.78);
}

.tutorial-text {
  flex: 1;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.5;
}

.tutorial-item:last-child {
  margin-bottom: 0;
}
