@import "../../styles/drawing-icons.wxss";

.tutorial-item {
  margin-bottom: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #EEF2F7;
  border-radius: 16rpx;
  background: #F8FAFC;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.tutorial-icon {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}

.tutorial-icon .tool-icon {
  transform: scale(0.78);
}

.tutorial-text {
  flex: 1;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.5;
}

.tutorial-item:last-child {
  margin-bottom: 0;
}
